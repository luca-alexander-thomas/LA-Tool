# Django
SECRET_KEY=dein-geheimer-schluessel-hier
DEBUG=True
HOSTNAME=localhost
# Weitere Hostnamen, durch Komma getrennt
EXTRA_HOSTS=
# Produktion hinter HTTPS-Proxy: erst auf True, wenn der Proxy „X-Forwarded-Proto: https“ setzt
TRUST_X_FORWARDED_PROTO=False
# HTTP→HTTPS-Weiterleitung durch Django (meist erledigt das schon der Proxy)
SECURE_SSL_REDIRECT=False

# Datenbank
DATABASE_TYPE=sqlite3
DB_SQLITE_FILE=db.sqlite3
# Fuer MySQL:
# DATABASE_TYPE=mysql
# DB_MYSQL_HOST=localhost
# DB_MYSQL_PORT=3306
# DB_MYSQL_USER=
# DB_MYSQL_PASSWORD=
# DB_MYSQL_NAME=

# Microsoft Entra ID (Azure AD)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:8000/microsoft-callback/
AZURE_GROUP_ADMINS_ID=
AZURE_GROUP_USERS_ID=

# Divera 24/7
DIVERA_ADMIN_USER_API_KEY=
DIVERA_SITE_ID=20369
# Divera-Gruppe, deren Termine als Dienste importiert werden
DIVERA_EVENTS_GROUP=Jugendliche

# Web Push (PWA-Benachrichtigungen) – Schlüssel erzeugen mit: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt fuer Push-Dienste (mailto: oder https:)
VAPID_SUBJECT=mailto:admin@example.org
